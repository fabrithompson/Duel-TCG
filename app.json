{
  "expo": {
    "name": "Duel",
    "slug": "duel",
    "scheme": "duel",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ar.duel.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ar.duel.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF6EF"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Duel",
      "shortName": "Duel",
      "lang": "es",
      "themeColor": "#FBF6EF",
      "backgroundColor": "#FBF6EF"
    },
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Duel usa tus fotos solo para tu foto de perfil y el logo del local.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF6EF",
          "image": "./assets/brand/duel-logo.png",
          "dark": {
            "backgroundColor": "#14100D",
            "image": "./assets/brand/duel-logo.png"
          },
          "imageWidth": 200
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b3de08d5-2231-4aa2-a344-a2fa59f49e0e"
      }
    },
    "owner": "fabrithompson"
  }
}
