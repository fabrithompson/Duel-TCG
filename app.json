{
  "expo": {
    "name": "Duel",
    "slug": "duel",
    "scheme": "duel",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF6EF"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Duel usa tus fotos solo para cargar el logo del local.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF6EF",
          "image": "./assets/brand/isotipo.png",
          "dark": {
            "backgroundColor": "#14100D",
            "image": "./assets/brand/duel-mark-dark.png"
          },
          "imageWidth": 140
        }
      ],
      "expo-status-bar"
    ]
  }
}
