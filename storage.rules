rules_version = '2';

// logos/: logo del local, lectura pública para el splash.
// avatares/{uid}/: foto de perfil de cada uno; la ve cualquiera con sesión.
// Todo lo demás queda denegado.

service firebase.storage {
  match /b/{bucket}/o {

    function perfil() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function esAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && perfil().get('role', '') == 'admin'
        && perfil().get('estadoAprobacion', '') == 'aprobado';
    }

    function imagenValida() {
      return request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpe?g|webp|gif|heic|heif)');
    }

    match /logos/{ruta=**} {
      allow read: if true;
      allow create, update: if esAdmin() && imagenValida();
      allow delete: if esAdmin();
    }

    match /avatares/{uid}/{archivo} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid && imagenValida();
      allow delete: if request.auth != null && (request.auth.uid == uid || esAdmin());
    }
  }
}
